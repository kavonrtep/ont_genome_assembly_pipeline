        """
        scripts_dir=$(realpath scripts)
        export PATH=$scripts_dir:$PATH
        minimap2 -x {DOTPLOT_PRESET} -t {threads} {input.reference} {input.fasta} \
          > {params.paf} 2> {log}
        paf_dotplot.py -p {params.paf} -o {output.png} \
          --query_name {wildcards.hap} --target_name reference >> {log} 2>&1
        """


# --- Parental / subgenome assignment (Axis 2) ---------------------------------

rule parental_triobin:
    input:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa"),
        pat_yak=yak_path("assign_paternal"),
        mat_yak=yak_path("assign_maternal")
    output:
        triobin=os.path.join(PARENTAL_DIR, "{hap}.triobin")
    conda:
        "envs/yak.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "parental_triobin_{hap}.log")
    shell:
        """
        yak triobin {input.pat_yak} {input.mat_yak} {input.fasta} \
          > {output.triobin} 2> {log}
        """


rule parental_assignment_merge:
    input:
        triobin=[os.path.join(PARENTAL_DIR, f"{hap}.triobin") for hap in HAPS],
        fastas=[fasta_for(hap) for hap in HAPS]
    output:
        table=os.path.join(PARENTAL_DIR, "parental_assignment.tsv")
    params:
        triobin_args=" ".join(
            f"-t {hap}:{os.path.join(PARENTAL_DIR, hap + '.triobin')}" for hap in HAPS
        ),
