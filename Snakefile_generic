rule filter_reads:
    input:
        fastq=ONT_FASTQ,
        fasta=os.path.join(DATA_DIR, "reads.fasta"),
        plastid=os.path.join(DATA_DIR, "contam_plastid.tsv"),
        mito=os.path.join(DATA_DIR, "contam_mitochondrial.tsv")
    output:
        fastq=os.path.join(DATA_DIR, "reads.filtered.fastq"),
        fasta=os.path.join(DATA_DIR, "reads.filtered.fasta")
    conda:
        "envs/pysam.yaml"
    log:
        os.path.join(LOG_DIR, "filter_reads.log")
    shell:
        """
        filter_fastq_fasta.py -i {input.fastq} -r {input.plastid} {input.mito} \
          -o {output.fastq} --format fastq --trim_start {TRIM_START} \
          --trim_end {TRIM_END} > {log} 2>&1
        filter_fastq_fasta.py -i {input.fasta} -r {input.plastid} {input.mito} \
          -o {output.fasta} --format fasta --trim_start {TRIM_START} \
          --trim_end {TRIM_END} >> {log} 2>&1
        """


rule hifiasm_assembly:
    input:
        fastq=os.path.join(DATA_DIR, "reads.filtered.fastq")
    output:
        marker=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.hifiasm.done")
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "hifiasm.log")
    shell:
        """
        hifiasm -o {ASSEMBLY_DIR}/{PREFIX} -t {threads} {BASE_ARGS} --ont {input.fastq} {EXTRA_ARGS} > {log} 2>&1
        touch {output.marker}
        """


rule assembly_gfa_manifest:
    input:
        marker=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.hifiasm.done")
    output:
        manifest=os.path.join(ASSEMBLY_DIR, "assembly.gfa.outputs.tsv")
    run:
        gfa_paths = sorted(glob.glob(os.path.join(ASSEMBLY_DIR, f"{PREFIX}*.gfa")))
        with open(output.manifest, "w") as out:
            out.write("label\tpath\ttype\n")
            for path in gfa_paths:
                label = os.path.basename(path)
                if path.endswith(".bp.p_ctg.gfa"):
                    label = "primary"
                elif ".hap1." in path:
                    label = "hap1"
                elif ".hap2." in path:
                    label = "hap2"
                elif ".bp.hap" in path:
                    label = os.path.basename(path).replace(f"{PREFIX}.", "").replace(".gfa", "")
                out.write(f"{label}\t{path}\tgfa\n")


rule gfa_to_fastas:
    input:
        manifest=os.path.join(ASSEMBLY_DIR, "assembly.gfa.outputs.tsv")
    output:
        primary=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.bp.p_ctg.fasta"),
        marker=os.path.join(ASSEMBLY_DIR, "assembly_fastas.done"),
        manifest=os.path.join(ASSEMBLY_DIR, "assembly.outputs.tsv")
    shell:
        """
        cp {input.manifest} {output.manifest}
        awk 'NR > 1 && $3 == "gfa" {{ print $1"\\t"$2 }}' {input.manifest} | while IFS="$(printf '\\t')" read label gfa; do
            fasta="${{gfa%.gfa}}.fasta"
            awk '/^S/{{print ">"$2"\\n"$3}}' "$gfa" | fold > "$fasta"
            printf "%s_fasta\\t%s\\tfasta\\n" "$label" "$fasta" >> {output.manifest}
        done
        touch {output.marker}
        """


rule run_quast:
    input:
        primary=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.bp.p_ctg.fasta")
    output:
        marker=os.path.join(QUAST_DIR, "quast_done.txt")
    conda:
        "envs/quast.yaml"
    shell:
        """
        quast {input.primary} -o {QUAST_DIR}
        touch {output.marker}
        """


rule map_reads_back:
    input:
        marker=os.path.join(ASSEMBLY_DIR, "assembly_fastas.done"),
        assembly=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.bp.p_ctg.fasta"),
        fastq=os.path.join(DATA_DIR, "reads.filtered.fastq")
    output:
        bam=os.path.join(MAPPING_DIR, "reads_to_primary.sorted.bam"),
        csi=os.path.join(MAPPING_DIR, "reads_to_primary.sorted.bam.csi")
    conda:
        "envs/basic_tools.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "map_reads_back.log")
    shell:
        """
        dorado aligner {input.assembly} {input.fastq} 2> {log} | \
          samtools sort -@ {threads} -o {output.bam} -
        samtools index -c {output.bam}
        """
