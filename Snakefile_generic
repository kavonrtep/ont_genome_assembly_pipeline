rule yak_count:
    input:
        reads=lambda wc: YAK_SOURCES[wc.yakname]
    output:
        yak=os.path.join(YAK_DIR, "{yakname}.yak")
    conda:
        "envs/yak.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "yak_count_{yakname}.log")
    shell:
        # For strict paired-end k-mer dedup yak recommends the two-stream form;
        # here we pass the read files directly, which is adequate for trio/triobin.
        """
        yak count -b37 -t {threads} -o {output.yak} {input.reads} > {log} 2>&1
        """


# --- Assembly -----------------------------------------------------------------

def hifiasm_inputs(wildcards):
    inputs = {"fastq": os.path.join(DATA_DIR, "reads.filtered.fastq")}
    if MODE == "trio":
        inputs["pat_yak"] = yak_path("trio_paternal")
        inputs["mat_yak"] = yak_path("trio_maternal")
    elif MODE in ("hic", "triploid_hic"):
        inputs["hic_r1"] = HIC_R1
        inputs["hic_r2"] = HIC_R2
    return inputs


def hifiasm_mode_flags(wildcards, input):
    if MODE == "trio":
        return f"-1 {input.pat_yak} -2 {input.mat_yak}"
    if MODE in ("hic", "triploid_hic"):
        flags = f"--h1 {input.hic_r1} --h2 {input.hic_r2}"
        if ENZYME:
            flags += f" --enzyme {ENZYME}"
        if MODE == "triploid_hic":
            flags += " --n-hap 3"
        return flags
    return ""


rule hifiasm_assembly:
    input:
        unpack(hifiasm_inputs)
    output:
        marker=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.hifiasm.done")
    params:
        mode_flags=hifiasm_mode_flags
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "hifiasm.log")
    shell:
        """
        hifiasm -o {ASSEMBLY_DIR}/{PREFIX} -t {threads} {BASE_ARGS} {READ_FLAG} \
          {params.mode_flags} {input.fastq} {EXTRA_ARGS} > {log} 2>&1
        touch {output.marker}
        """


rule gfa_to_fasta:
    input:
        marker=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.hifiasm.done")
    output:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa"),
        fai=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa.fai")
    params:
        gfa=lambda wc: gfa_source(wc.hap)
    conda:
        "envs/basic_tools.yaml"
    shell:
        """
        if [ ! -s "{params.gfa}" ]; then
            echo "Expected hifiasm output {params.gfa} for haplotype '{wildcards.hap}' not found." >&2
            exit 1
        fi
        awk '/^S/{{print ">"$2"\\n"$3}}' {params.gfa} | fold > {output.fasta}
        samtools faidx {output.fasta}
        """


rule assembly_manifest:
    input:
        fastas=[fasta_for(hap) for hap in HAPS]
    output:
        manifest=os.path.join(ASSEMBLY_DIR, "assembly.outputs.tsv")
    run:
        with open(output.manifest, "w") as out:
            out.write("haplotype\tfasta\tgfa\n")
            for hap in HAPS:
                out.write(f"{hap}\t{fasta_for(hap)}\t{gfa_source(hap)}\n")


# --- Per-haplotype analyses ---------------------------------------------------

rule run_quast:
    input:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa")
    output:
        marker=os.path.join(QUAST_DIR, "{hap}", "quast_done.txt")
    conda:
        "envs/quast.yaml"
    shell:
        """
        quast {input.fasta} -o {QUAST_DIR}/{wildcards.hap}
        touch {output.marker}
        """


rule map_reads_back:
    input:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa"),
        fastq=os.path.join(DATA_DIR, "reads.filtered.fastq")
    output:
        bam=os.path.join(MAPPING_DIR, "reads_to_{hap}.sorted.bam"),
        csi=os.path.join(MAPPING_DIR, "reads_to_{hap}.sorted.bam.csi")
    conda:
        "envs/basic_tools.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "map_reads_back_{hap}.log")
    shell:
        """
        minimap2 -a -x {MAP_PRESET} -t {threads} {input.fasta} {input.fastq} 2> {log} | \
          samtools sort -@ {threads} -o {output.bam} -
        samtools index -c {output.bam}
        """


rule run_tidecluster:
    input:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa")
    output:
        marker=os.path.join(TIDECLUSTER_DIR, "{hap}", "tc_done.txt"),
        # rDNA (ribosomal) locations: run_all writes <prefix>_rdna.tsv by
        # default using TideCluster's built-in rRNA library. It maps each
        # tandem-repeat cluster (TRC) to its rDNA type (5S/45S) + coverage;
        # genomic coordinates come from the TRCs in tc_clustering.gff3.
        rdna=os.path.join(TIDECLUSTER_DIR, "{hap}", "tc_rdna.tsv")
    params:
        prefix=os.path.join(TIDECLUSTER_DIR, "{hap}", "tc"),
        library=(f"-l {TC_LIBRARY}" if TC_LIBRARY else ""),
        rdna_args=TC_RDNA_ARGS
    conda:
        "envs/tidecluster.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "tidecluster_{hap}.log")
    shell:
        """
        TideCluster.py run_all -f {input.fasta} -pr {params.prefix} {params.library} \
          {params.rdna_args} -c {threads} > {log} 2>&1
        # run_all writes {params.prefix}_rdna.tsv; guarantee the declared output
        # exists even if the assembly carries no detectable rDNA.
        if [ ! -f {output.rdna} ]; then
            printf "TRC\\trDNA_type\\tcoverage\\n" > {output.rdna}
        fi
        touch {output.marker}
        """


rule find_telomeres:
    input:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa")
    output:
        marker=os.path.join(TELOMERE_DIR, "{hap}", "telomere_done.txt")
    params:
        outdir=os.path.join(TELOMERE_DIR, "{hap}")
    conda:
        "envs/tidk.yaml"
    log:
        os.path.join(LOG_DIR, "telomere_{hap}.log")
    shell:
        """
        tidk search --string {TELO_MOTIF} --output {wildcards.hap} \
          --dir {params.outdir} {input.fasta} > {log} 2>&1
        tidk plot --tsv {params.outdir}/{wildcards.hap}_telomeric_repeat_windows.tsv \
          --output {params.outdir}/{wildcards.hap}_telomere >> {log} 2>&1 || true
        touch {output.marker}
        """


