configfile: "config_generic_template.yaml"

import os
import glob


def cfg(path, default=None):
    value = config
    for key in path.split("."):
        if not isinstance(value, dict) or key not in value:
            return default
        value = value[key]
    return value


def as_list(value):
    """Accept a single path or a comma-separated string; return a list."""
    if not value:
        return []
    if isinstance(value, (list, tuple)):
        return [str(v) for v in value if v]
    return [part.strip() for part in str(value).split(",") if part.strip()]


OUTPUT_DIR = cfg("outputs.output_dir", config.get("output_dir", "output_generic"))
DATA_DIR = os.path.join(OUTPUT_DIR, "data")
ASSEMBLY_DIR = os.path.join(OUTPUT_DIR, "assembly")
QUAST_DIR = os.path.join(OUTPUT_DIR, "quast")
LOG_DIR = os.path.join(OUTPUT_DIR, "logs")
MAPPING_DIR = os.path.join(OUTPUT_DIR, "mapping")
ANALYSIS_DIR = os.path.join(OUTPUT_DIR, "analysis")
TIDECLUSTER_DIR = os.path.join(ANALYSIS_DIR, "tidecluster")
TELOMERE_DIR = os.path.join(ANALYSIS_DIR, "telomere")
REFASSIGN_DIR = os.path.join(ANALYSIS_DIR, "reference_assignment")
DOTPLOT_DIR = os.path.join(ANALYSIS_DIR, "dotplots")
PARENTAL_DIR = os.path.join(ANALYSIS_DIR, "parental_assignment")
YAK_DIR = os.path.join(DATA_DIR, "yak")

PREFIX = cfg("assembly.output_prefix", cfg("hifiasm.output_prefix", "assembly"))
READ_TYPE = cfg("assembly.read_type", cfg("hifiasm.read_type", "ont"))
BASE_ARGS = cfg("assembly.base_args", cfg("hifiasm.base_args", "-W"))
EXTRA_ARGS = cfg("assembly.extra_args", cfg("hifiasm.extra_args", ""))
MODE = cfg("assembly.mode", "primary")
ENZYME = cfg("assembly.enzyme", "")

READ_TYPE_FLAGS = {"ont": "--ont", "hifi": ""}
if READ_TYPE not in READ_TYPE_FLAGS:
    raise ValueError("Snakefile_generic supports assembly.read_type: ont or hifi.")
READ_FLAG = READ_TYPE_FLAGS[READ_TYPE]
MAP_PRESET = "map-hifi" if READ_TYPE == "hifi" else "lr:hq"

# Long reads for assembly (HiFi or ONT). Falls back to the legacy flat key.
if READ_TYPE == "hifi":
    READS_FASTQ = cfg("reads.hifi_fastq")
else:
    READS_FASTQ = cfg("reads.ont_fastq", config.get("oxford_nanopore_reads"))

# --- Phasing mode -> expected haplotype set -----------------------------------
# label -> hifiasm gfa filename suffix (relative to {PREFIX}.<suffix>.gfa).
# NOTE: the exact per-mode hifiasm filenames are validated against a real run;
# adjust here if the pinned fork names outputs differently.
MODE_HAP_GFA = {
    "primary": {"primary": "bp.p_ctg"},
    "phased": {"primary": "bp.p_ctg", "hap1": "bp.hap1.p_ctg", "hap2": "bp.hap2.p_ctg"},
    "hic": {"primary": "hic.p_ctg", "hap1": "hic.hap1.p_ctg", "hap2": "hic.hap2.p_ctg"},
    "trio": {"hap1": "dip.hap1.p_ctg", "hap2": "dip.hap2.p_ctg"},
    "triploid_hic": {"hap1": "hic.hap1.p_ctg", "hap2": "hic.hap2.p_ctg", "hap3": "hic.hap3.p_ctg"},
}
if MODE not in MODE_HAP_GFA:
    raise ValueError(
        "assembly.mode must be one of: " + ", ".join(sorted(MODE_HAP_GFA)) + f" (got '{MODE}')."
    )
HAP_GFA = dict(MODE_HAP_GFA[MODE])
_override = cfg("assembly.haplotypes", [])
if _override:
    unknown = [h for h in _override if h not in HAP_GFA]
    if unknown:
        raise ValueError(f"assembly.haplotypes {unknown} not produced by mode '{MODE}'.")
    HAP_GFA = {h: HAP_GFA[h] for h in _override}
HAPS = list(HAP_GFA.keys())

# --- Hi-C / trio inputs -------------------------------------------------------
HIC_R1 = cfg("reads.hic_r1", "")
HIC_R2 = cfg("reads.hic_r2", "")
TRIO_PAT = as_list(cfg("assembly.trio.paternal_illumina", ""))
TRIO_MAT = as_list(cfg("assembly.trio.maternal_illumina", ""))

# --- Parental / subgenome assignment (Axis 2) ---------------------------------
PA_ENABLED = bool(cfg("parental_assignment.enabled", False))
PA_METHOD = cfg("parental_assignment.method", "triobin")
PA_PAT = as_list(cfg("parental_assignment.paternal_illumina", ""))
PA_MAT = as_list(cfg("parental_assignment.maternal_illumina", ""))
PA_LAB_PAT = cfg("parental_assignment.subgenome_labels.paternal", "paternal")
PA_LAB_MAT = cfg("parental_assignment.subgenome_labels.maternal", "maternal")
PA_BIN = bool(cfg("parental_assignment.emit_binned_fastas", False))

# --- Optional per-haplotype annotation steps ----------------------------------
QUAST_ENABLED = bool(cfg("quast.enabled", cfg("steps.quast", True)))
MAP_ENABLED = bool(cfg("map_reads_back.enabled", cfg("steps.map_reads_back", False)))
TC_ENABLED = bool(cfg("tidecluster.enabled", False))
TC_LIBRARY = cfg("tidecluster.library", "")
# rDNA detection is on by default in TideCluster run_all; expose its thresholds
# (blank -> TideCluster defaults).
_tc_rdna_args = []
if cfg("tidecluster.rdna_min_coverage", "") not in ("", None):
    _tc_rdna_args += ["--rdna_min_coverage", str(cfg("tidecluster.rdna_min_coverage"))]
if cfg("tidecluster.rdna_min_identity", "") not in ("", None):
    _tc_rdna_args += ["--rdna_min_identity", str(cfg("tidecluster.rdna_min_identity"))]
TC_RDNA_ARGS = " ".join(_tc_rdna_args)
TELO_ENABLED = bool(cfg("telomere.enabled", False))
TELO_MOTIF = cfg("telomere.motif", "CCCTAAA")
REFASSIGN_ENABLED = bool(cfg("reference_assignment.enabled", False))
DOTPLOT_ENABLED = bool(cfg("dotplot_vs_reference.enabled", False))
DOTPLOT_PRESET = cfg("dotplot_vs_reference.preset", "asm20")
REFERENCE = cfg("reference.fasta", "")

# --- Contamination filter -----------------------------------------------------
FILTER_ENABLED = cfg("contamination_filter.enabled", True)
PLASTID_DB = cfg("contamination_filter.plastid_db")
MITO_DB = cfg("contamination_filter.mitochondrial_db")
MIN_COVERAGE = cfg("contamination_filter.min_coverage", 90)
MIN_IDENTITY = cfg("contamination_filter.min_identity", 90)
WORD_SIZE = cfg("contamination_filter.word_size", 21)
TRIM_START = cfg("read_trimming.trim_start", 0)
TRIM_END = cfg("read_trimming.trim_end", 0)

# --- Validation ---------------------------------------------------------------
if not READS_FASTQ:
    raise ValueError("Missing reads.ont_fastq (or reads.hifi_fastq for hifi) in config.")
if FILTER_ENABLED and (not PLASTID_DB or not MITO_DB):
    raise ValueError(
        "contamination_filter.plastid_db and mitochondrial_db are required when "
        "contamination_filter.enabled is true."
    )
if MODE in ("hic", "triploid_hic") and not (HIC_R1 and HIC_R2):
    raise ValueError(f"assembly.mode '{MODE}' requires reads.hic_r1 and reads.hic_r2.")
if MODE == "trio" and not (TRIO_PAT and TRIO_MAT):
    raise ValueError(
        "assembly.mode 'trio' requires assembly.trio.paternal_illumina and "
        "maternal_illumina (hifiasm trio needs both parents)."
    )
if (REFASSIGN_ENABLED or DOTPLOT_ENABLED) and not REFERENCE:
    raise ValueError(
        "reference.fasta is required when reference_assignment or "
        "dotplot_vs_reference is enabled."
    )
if PA_ENABLED:
    if PA_METHOD != "triobin":
        raise ValueError("parental_assignment.method: only 'triobin' is implemented.")
    if not (PA_PAT and PA_MAT):
        raise ValueError(
            "parental_assignment.method 'triobin' requires both paternal_illumina "
            "and maternal_illumina (yak triobin needs both parents)."
        )

# --- yak k-mer database sources ----------------------------------------------
YAK_SOURCES = {}
if MODE == "trio":
    YAK_SOURCES["trio_paternal"] = TRIO_PAT
    YAK_SOURCES["trio_maternal"] = TRIO_MAT
if PA_ENABLED:
    YAK_SOURCES["assign_paternal"] = PA_PAT
    YAK_SOURCES["assign_maternal"] = PA_MAT


def yak_path(name):
    return os.path.join(YAK_DIR, f"{name}.yak")


def fasta_for(hap):
    return os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{hap}.fa")


def gfa_source(hap):
    return os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{HAP_GFA[hap]}.gfa")


ALL_DIRS = [
    OUTPUT_DIR, DATA_DIR, ASSEMBLY_DIR, QUAST_DIR, LOG_DIR, MAPPING_DIR,
    ANALYSIS_DIR, TIDECLUSTER_DIR, TELOMERE_DIR, REFASSIGN_DIR, DOTPLOT_DIR,
    PARENTAL_DIR, YAK_DIR,
]
for path in ALL_DIRS:
    os.makedirs(path, exist_ok=True)


wildcard_constraints:
    hap="|".join(HAPS) if HAPS else "NONE",
    yakname="[A-Za-z0-9_]+",


def selected_targets():
    targets = [
        os.path.join(DATA_DIR, "reads.filtered.fastq"),
        os.path.join(DATA_DIR, "reads.filtered.fasta"),
        os.path.join(ASSEMBLY_DIR, f"{PREFIX}.hifiasm.done"),
        os.path.join(ASSEMBLY_DIR, "assembly.outputs.tsv"),
    ]
    targets += [fasta_for(hap) for hap in HAPS]
    if QUAST_ENABLED:
        targets += [os.path.join(QUAST_DIR, hap, "quast_done.txt") for hap in HAPS]
    if MAP_ENABLED:
        targets += [os.path.join(MAPPING_DIR, f"reads_to_{hap}.sorted.bam") for hap in HAPS]
    if TC_ENABLED:
        targets += [os.path.join(TIDECLUSTER_DIR, hap, "tc_done.txt") for hap in HAPS]
    if TELO_ENABLED:
        targets += [os.path.join(TELOMERE_DIR, hap, "telomere_done.txt") for hap in HAPS]
    if REFASSIGN_ENABLED:
        targets += [os.path.join(REFASSIGN_DIR, hap, "ragtag.scaffold.fasta") for hap in HAPS]
    if DOTPLOT_ENABLED:
        targets += [os.path.join(DOTPLOT_DIR, f"{hap}_vs_reference.png") for hap in HAPS]
    if PA_ENABLED:
        targets.append(os.path.join(PARENTAL_DIR, "parental_assignment.tsv"))
    return targets


rule all:
    input:
        selected_targets()


# --- Read preparation and contamination filtering -----------------------------

rule convert_fastq_to_fasta:
    input:
        fastq=READS_FASTQ
    output:
        fasta=os.path.join(DATA_DIR, "reads.fasta")
    conda:
        "envs/pysam.yaml"
    log:
        os.path.join(LOG_DIR, "convert_fastq_to_fasta.log")
    shell:
        """
        seqkit fq2fa {input.fastq} > {output.fasta} 2> {log}
        """


rule detect_contamination_plastid:
    input:
        fasta=os.path.join(DATA_DIR, "reads.fasta")
    output:
        tsv=os.path.join(DATA_DIR, "contam_plastid.tsv")
    conda:
        "envs/pysam.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "detect_contamination_plastid.log")
    shell:
        """
        if [ "{FILTER_ENABLED}" = "True" ]; then
            cp {PLASTID_DB} {DATA_DIR}/plastid.fasta
            makeblastdb -in {DATA_DIR}/plastid.fasta -dbtype nucl > {log} 2>&1
            detect_contamination.py -i {input.fasta} -o {output.tsv} \
              --min_coverage {MIN_COVERAGE} --min_identity {MIN_IDENTITY} \
              --num_cpu {threads} -d {DATA_DIR}/plastid.fasta \
              --word_size {WORD_SIZE} --raw_blast {DATA_DIR}/plastid.blast \
              >> {log} 2>&1
        else
            printf "ReadID\\tQueryLength\\tAlignedLength\\tCoverage(%%)\\tMeanIdentity(%%)\\n" > {output.tsv}
        fi
        """


