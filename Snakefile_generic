rule dotplot_vs_reference:
    input:
        fasta=os.path.join(ASSEMBLY_DIR, f"{PREFIX}.{{hap}}.fa"),
        reference=(REFERENCE if REFERENCE else [])
    output:
        png=os.path.join(DOTPLOT_DIR, "{hap}_vs_reference.png")
    params:
        paf=os.path.join(DOTPLOT_DIR, "{hap}_vs_reference.paf")
    conda:
        "envs/dotplot.yaml"
    threads: workflow.cores
    log:
        os.path.join(LOG_DIR, "dotplot_{hap}.log")
